services:
  app:
    image: "{{ release_image }}"
    container_name: "{{ release.app_name }}-{{ target.name }}"
    restart: "{{ target.restart_policy }}"
    env_file:
      - "{{ runtime_env_file_path }}"
    ports:
      - "{{ target.host_port }}:{{ target.container_port }}"
{% if resolved_extra_volumes | default([]) | length > 0 %}
    volumes:
{% for volume in resolved_extra_volumes %}
      - "{{ volume }}"
{% endfor %}
{% endif %}
    labels:
      deployment.country: "{{ country }}"
      deployment.environment: "{{ deploy_env }}"
      deployment.target: "{{ target.name }}"
      deployment.image-version: "{{ image_version }}"
    networks:
      - app

networks:
  app:
    name: "{{ release.app_name }}-{{ target.name }}-network"
