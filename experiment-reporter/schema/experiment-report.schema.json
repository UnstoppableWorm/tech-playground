{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-playground.local/schemas/experiment-report-v1.json",
  "title": "Tech Playground Experiment Report",
  "type": "object",
  "required": ["schemaVersion", "lab", "title", "charts", "results"],
  "properties": {
    "schemaVersion": {"const": 1},
    "lab": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "group", "metrics"],
        "properties": {
          "directory": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string"},
          "group": {"type": "string"},
          "type": {"enum": ["bar", "line"]},
          "x": {
            "type": "object",
            "required": ["key", "label"],
            "properties": {
              "key": {"type": "string"},
              "label": {"type": "string"}
            }
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["value", "label"],
              "properties": {
                "value": {"type": "string"},
                "label": {"type": "string"}
              }
            }
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["key", "label", "unit"],
              "properties": {
                "key": {"type": "string"},
                "label": {"type": "string"},
                "unit": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group", "scenario", "parameters", "metrics"],
        "properties": {
          "order": {"type": "integer"},
          "group": {"type": "string"},
          "scenario": {"type": "string"},
          "series": {"type": "string"},
          "spec": {"type": "string"},
          "status": {"type": "string"},
          "parameters": {"type": "object"},
          "metrics": {
            "type": "object",
            "additionalProperties": {"type": "number"}
          }
        }
      }
    }
  }
}
